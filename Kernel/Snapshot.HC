//============================================================================
// Snapshot.HC - boot real TempleOS in hemu from a qemu RAM+register snapshot.
//
// RAM is identity-mapped (TempleOS maps virtual==physical), segments are flat
// (FS/GS via MSR base). Completed frames come from the OS's planar screen
// image, after its cache update and native zoom. Devices emulated: PIC, PIT
// (IRQ0 scheduler tick), CMOS RTC, LAPIC/HPET MMIO, and PS/2 keyboard+mouse.
//
// The CPU state is seeded from SnapRegs.HC, generated by Misc/RegsMk.mjs from
// a VM-paused capture so registers and RAM are consistent (see Misc/RegsMk.mjs).
//============================================================================
// The per-core CPU state (CCpuState g_cpu_st[], the reg/rip/rfl... #defines), the SMP mailboxes and the
// guest-call codes live in Core.HC, which Cpu.HC includes first.
#include "Cpu"
#ifdef SMP_SNAP
#include "SnapRegsSmp"	       // multi-core: seeds g_cpu_st[0..N-1] (Misc/RegsMk.mjs)
#else
#include "SnapRegs"			// single-core: SetSnapRegs() - generated by Misc/RegsMk.mjs
#endif

Bool g_names_ok;	//GuestNamesFind found all it looks for in this guest.

U0 Present()
{//Only completed new frames. Startup never exposes a live draw buffer.
  if (g_desk_ready && g_desk_seq!=g_present_seq) {
    __present(g_desk,640,480);
    g_present_seq=g_desk_seq;
  }
}

U64 g_inited,g_budget;

// Input is pulled from the host each frame so the SAME Snapshot.HC serves both runners: the Node
// harness (snap-run.mjs) feeds a synthetic cursor sweep + keystrokes to prove animation headlessly,
// and the browser host (web/hemu.js) feeds real mouse/keyboard.  __host_msx/msy = absolute cursor
// (0..639,0..479); __host_msb = button bits; __host_key = next set-1 scancode, or <0 when drained.
U0 Frame()
{
  I64 mx = __host_msx(), my = __host_msy(), mb = __host_msb();
  if (mx < 0) mx = 0; else if (mx > 639) mx = 639; if (my < 0) my = 0; else if (my > 479) my = 479;
  if (g_names_ok) {//DrawMs draws at pos, windows and menus use pos_text.
    *(mem+guest.ms_pos+of_d3.x)(I64*)=mx;
    *(mem+guest.ms_pos+of_d3.y)(I64*)=my;
    *(mem+guest.ms_pos+of_d3.z)(I64*)=__host_wheel;
    *(mem+guest.ms_pos_text+of_d3.x)(I64*)=mx/8;
    *(mem+guest.ms_pos_text+of_d3.y)(I64*)=my/8;
    mem[guest.ms_lb]=mb&1;
    mem[guest.ms_rb]=mb>>1&1;
  }
  I64 sc;
  // Leave excess events in the host queue until IRQ1 has room. Overwriting this
  // ring discarded key releases during long frames and left movement held.
  while (kbd_qt-kbd_qh < 64) {
    sc = __host_key(); if (sc < 0) break;
    InjectKey(sc);
  }
  if (g_names_ok) mem[guest.ms_hard_installed]=1;
  I64 ns=__host_ns(),budget=__host_budget();
  ns=ClampI64(ns,0,100000000);
  budget=MaxI64(budget,1);
  TimeFrame(ns,budget);
  g_budget=icount+budget;
  Run(g_budget);
  Present;
}

U0 HookArm(U64 a)
{
  if (a) g_hooktbl[a&0xFFFF]=1;
}

U0 RasterArm(U8 *name)
{//The guest's named graphics routine, independent of its caller.
  U64 a=GuestFun(name);
  I64 slot;
  if (a && g_raster_n<2) {
    g_raster_hle[g_raster_n++]=a;
    HookArm(a);
    slot=(a^(a>>16))&0xFFFF;
    g_jit_rip[slot]=a;
    g_jit_n[slot]=-2;
  }
}

U0 VideoHookArm()
{//Keep the compositor's small calls inside the compiled dispatch loop.
  I64 i,slot;
  U64 a;
  for (i=0;i<3;i++) {
    if (!i) a=video_blot;
    else if (i==1) a=video_line;
    else a=video_flush;
    if (a) {
      slot=(a^a>>16)&0xFFFF;
      g_jit_rip[slot]=a;
      g_jit_n[slot]=-2;
    }
  }
}

U0 HooksArm()
{//The fast paths, at the guest's own functions. The capture is where
//GrUpdateScrn returns from its VGA update, with the OS image complete.
  I64 slot;
  g_dc_transform=GuestFun("DCTransform");
  HookArm(g_hle_blit=GuestFun("DCBlotColor8"));
  HookArm(g_capture_rip=GuestCallRet(GuestFun("GrUpdateScrn"),
	GuestFun("GrUpdateVGAGraphics"),1024));
  HookArm(g_capture_text=GuestCallRet(GuestFun("GrUpdateScrn"),
	GuestFun("GrUpdateTextModeText"),1024));
  video_image=GuestVarMember("gr","CGrGlbls","scrn_image");
  video_reverse=GuestVar("rev_bits_table");
  HookArm(video_blot=GuestFun("DCBlotColor4"));
  HookArm(video_line=GuestFun("GrUpdateLine64"));
  HookArm(video_flush=GuestFun("GrUpdateLine64FlushCache"));
  VideoHookArm;
  RasterArm("GrHLine");
  RasterArm("GrVLine");
  if (g_poly3_hle=GuestFun("GrFillPoly3")) {
    HookArm(g_poly3_hle);
    slot=(g_poly3_hle^g_poly3_hle>>16)&0xFFFF;
    g_jit_rip[slot]=g_poly3_hle;
    g_jit_n[slot]=-2;
  }
  mem[guest.ms_hard_installed]=1;
}

#include "Display"

U0 HemuInit()			       // once: guest RAM, the snapshot, registers, HLE hooks, the JIT handoff
{
  InitMem(RAM_SIZE + SCR_SIZE);      // 384 MiB guest RAM + the 16 MiB host/guest scratch window above it
  __snap_load(mem);		     // host copies the TempleOS RAM snapshot into guest memory
  g_gc_sentinel = RAM_SIZE + SCR_SIZE - 16; mem[g_gc_sentinel] = 0xF4;	 // injected-call return sentinel: a HLT byte, never legitimately executed
  DevRst;
  SetSnapRegs();
  if (g_names_ok=GuestNamesFind(g_cpu_st[0].f_msr_fsbase)) {
    hpet_freq=GuestU64(GuestVarMember("cnts","CCntsGlbls","HPET_freq"));
    //The old RAM snapshots omit device registers. Resume their last
    //display time, so outstanding tS deadlines remain in the same epoch.
    F64 resume_tS=*(mem+guest.winmgr_last_refresh_tS)(F64*);
    I64 resume_ns=resume_tS*NS_SEC,resume_ticks=resume_tS*hpet_freq;
    tsc=resume_ns;
    hpet_ctr=GuestU64(GuestVarMember("cnts","CCntsGlbls","HPET_initial"))+
	  resume_ticks;
    HooksArm;
  }
  else
    "HEMU: this guest lacks a name HEMU needs; emulating only.\n";
  g_jit_on=CoreAttach;
  __jit_chain(&g_jit_rip[0], &g_jit_n[0]);	 // let the JIT build its native dispatch-loop module (chains blocks)
  g_inited = 1; 		      // (pit_div/tsc_rate/hpet are set per-frame by Frame() for wall-clock pacing)
}

U0 SnapshotResume()
{//A full machine image already has its CPU and devices. Rebuild only
//the host's compiled code, then show the saved completed frame.
  I64 i,slot;
  MemSet(g_jit_rip,0,sizeof(g_jit_rip));
  MemSet(g_jit_n,0,sizeof(g_jit_n));
  MemSet(g_jit_hot,0,sizeof(g_jit_hot));
  g_jit_on=CoreAttach;
  __jit_chain(g_jit_rip,g_jit_n);
  for (i=0;i<g_raster_n;i++) {
    slot=(g_raster_hle[i]^g_raster_hle[i]>>16)&0xFFFF;
    g_jit_rip[slot]=g_raster_hle[i];
    g_jit_n[slot]=-2;
  }
  if (g_poly3_hle) {
    slot=(g_poly3_hle^g_poly3_hle>>16)&0xFFFF;
    g_jit_rip[slot]=g_poly3_hle;
    g_jit_n[slot]=-2;
  }
  VideoHookArm;
  for (i=0;i<16;i++)
    VgaPaletteSend(i);
  UpdateSpk;
  g_present_seq=g_desk_seq-1;
  Present;
}

U0 Main()			       // the host calls Main once per display frame (holyc-wasm exports it as __main)
{ if (!g_inited) HemuInit(); Frame(); }
Main;
